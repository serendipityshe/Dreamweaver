{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "harness/src/**/*.ts",
    "core/src/**/*.ts",
    "agent/src/**/*.ts",
    "capacities/**/*.ts",
    "Lab/**/*.ts"
  ],
  "exclude": []
}
